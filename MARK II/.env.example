# ==============================================================================
# VENNELA A.I. 2.0 (MARK-II) — ENVIRONMENT CONFIGURATION TEMPLATE
# RYALI INDUSTRIES | PRODUCTION SECURITY STANDARD
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO VERSION CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SECURITY (MANDATORY - SEC-02 & SEC-03)
# ------------------------------------------------------------------------------
# Authoritative owner identifier for memory and multi-tenant task/reminder isolation
VENNELA_BOSS_ID=boss_primary_user_id

# High-entropy shared bearer token used by Desktop, Android, and internal services
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(32))"
VENNELA_AGENT_TOKEN=replace_with_high_entropy_secret_token_min_32_chars

# Comma-separated list of permitted CORS origins (SEC-05: Wildcard '*' is strictly prohibited)
VENNELA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,https://vennela-a-i.onrender.com,https://vennela.ai

# ------------------------------------------------------------------------------
# 2. RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
PORT=8000
LIGHTWEIGHT_MODE=true
VENNELA_TIMEZONE=Asia/Kolkata
DEFAULT_TIMEZONE=Asia/Kolkata
VENNELA_CHAT_ENABLED=true
VENNELA_API_BASE_URL=https://vennela-a-i.onrender.com
VENNELA_MEMORY_PROVIDER=mark_i
VENNELA_MEMORY_ENABLED=true

# System prompts and personality
SYSTEM_PROMPT="You are Vennela, a hyper-intelligent, proactive AI companion created by Ryali Industries."
VENNELA_PROMPT=
VENNELA_PERSONALITY="Loyal, witty, sharp, efficient, and protective of Boss."

# ------------------------------------------------------------------------------
# 3. LLM ROUTER PROVIDERS (SEC-07: Valid production models)
# ------------------------------------------------------------------------------
# OpenRouter (Primary LLM Router Gateway)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# Groq (Ultra-low latency inference & fallback: llama-3.3-70b-versatile, llama-3.1-8b-instant)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini (Multimodal inference & live streaming)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_MODEL_CHAIN=gemini-2.5-flash,gemini-2.0-flash,gemini-1.5-flash
GEMINI_MAX_RETRIES=3
GEMINI_BACKOFF_BASE=1.5

# ------------------------------------------------------------------------------
# 4. PERSISTENT STORAGE & MEMORY (SUPABASE — MARK-I TEMPORARY INTEGRATION)
# ------------------------------------------------------------------------------
# Target project URL (e.g. https://ymsbhyslvkcyipnglvlf.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co
# SECURITY CRITICAL:
# SUPABASE_KEY must contain the Supabase service_role key, NOT the anon/public key.
# public.memories has Row Level Security (RLS) enabled with zero policies, so anon/public
# keys cannot reliably read or write records. This is a privileged server-side credential:
# never commit it to source control, log it, or embed it in frontend/Android code.
SUPABASE_KEY=replace_with_supabase_service_role_key

# ------------------------------------------------------------------------------
# 5. WEB INTELLIGENCE & SEARCH (SEC-06: Strict SSRF protection enabled)
# ------------------------------------------------------------------------------
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# ------------------------------------------------------------------------------
# 6. TELEGRAM BOT INTEGRATION
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ_your_token
TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321
TELEGRAM_WEBHOOK_URL=https://vennela-a-i.onrender.com/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here

# ------------------------------------------------------------------------------
# 7. VOICE & AUDIO (OPTIONAL)
# ------------------------------------------------------------------------------
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ------------------------------------------------------------------------------
# 8. FIREBASE (LEGACY/OPTIONAL)
# ------------------------------------------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS=path/to/service_account.json
FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS_JSON=
